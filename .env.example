# Copy this file to .env and fill it in. See docs/INSTALL.md.

# Random secret for login cookies (required). Generate with:  openssl rand -hex 32
SECRET_KEY=

# Token that lets the panel send notifications (docs/INSTALL.md, step 7).
NTFY_TOKEN=

# Public addresses of the panel and of the notification server
BASE_URL=https://nobat.example.com
NTFY_PUBLIC_URL=https://ntfy.example.com

# Time zone for all dates and times (IANA name). Examples: Asia/Tehran, Asia/Kabul
TIMEZONE=Asia/Tehran

# Hour (0-23, in TIMEZONE) when the "you have sessions tomorrow" reminder goes out.
REMINDER_HOUR=20

# What the panel calls the people who receive appointments.
# Examples: مشاور / پزشک / درمانگر. The plural defaults to the label + "ان".
STAFF_LABEL=مشاور
# STAFF_LABEL_PLURAL=مشاوران

# Link to the source code, shown in the footer (required by the AGPL license).
# If you changed the code, point this to your own modified copy.
SOURCE_URL=https://github.com/PouryaFA81/Nobat

# Keep 1 in production (cookies only over HTTPS). Use 0 only for local testing over http.
COOKIE_SECURE=1
